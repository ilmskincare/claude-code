  withdrawnAt DateTime?    @db.Timestamptz(3)

  @@schema("public")
}

model PortfolioItem {
  id          String        @id @default(cuid())
  artistId    String
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
