// ─────────────────────────────────────────────────────────────────────────────
// Rebellious Ink Studio OS — Prisma schema
//
// Conventions
//  • All timestamps are timestamptz; the application converts to Europe/London.
//  • Money is stored in integer pence (GBP). Never floats.
//  • Health data lives in the `restricted` Postgres schema and is only reachable
//    through src/lib/health/* which enforces need-to-know access and logs it.
//  • Financial ledger entries and signed documents are append-only; corrections
//    are reversal entries, never updates.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "restricted"]
}

// ═══════════════════════════════ Tenancy & identity ═════════════════════════

model Studio {
  id              String   @id @default(cuid())
  name            String
  tradingName     String
  slug            String   @unique
  timezone        String   @default("Europe/London")
  currency        String   @default("GBP")
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  legalEntities   LegalEntity[]
  memberships     Membership[]
  stations        Station[]
  services        Service[]
  settings        StudioSetting[]
  bookingRequests BookingRequest[]
  appointments    Appointment[]
  roles           CustomRole[]

  @@schema("public")
}

/// A contracting party (e.g. the studio Ltd, or a chair-rent artist's own business).
model LegalEntity {
  id                 String   @id @default(cuid())
  studioId           String
  studio             Studio   @relation(fields: [studioId], references: [id])
  name               String
  companyNumber      String?
  vatNumber          String?
  addressLine1       String?
  addressLine2       String?
  town               String?
  postcode           String?
  country            String   @default("GB")
  isStudioEntity     Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  contracts          ArtistContractVersion[]
  invoices           Invoice[]

  @@schema("public")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @db.Timestamptz(3)
  image         String?
  phone         String?
  isSuspended   Boolean   @default(false)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  accounts       Account[]
  sessions       Session[]
  memberships    Membership[]
  clientProfile  ClientProfile?
  artistProfile  ArtistProfile?
  auditLogs      AuditLog[]      @relation("AuditActor")
  messages       Message[]
  notifications  Notification[]
  uploadedAssets ImageAsset[]
  invitations    Invitation[]    @relation("InvitedBy")
  verifiedPayments Payment[]     @relation("PaymentVerifier")
  bookingRequests BookingRequest[] @relation("ClientRequests")
  createdRequests BookingRequest[] @relation("CreatedByStaff")
  appointments    Appointment[]  @relation("ClientAppointments")
  payments        Payment[]      @relation("ClientPayments")
  quotesIssued    Quote[]        @relation("QuoteIssuer")
  holds           BookingHold[]
  deviceLogs      DeviceLog[]
  privacyPrefs    PrivacyPreference[]
  aiApprovals     AIActionApproval[]
  enrolments      Enrolment[]
  signoffs        MentorSignoff[] @relation("Mentor")
  signatures      Signature[]
  healthRecords   ClientHealthRecord[]
  healthAccess    HealthAccessLog[]
  skillProgress   SkillProgress[]      @relation("ApprenticeProgress")
  skillSignoffs   SkillProgress[]      @relation("SkillSignoffs")
  practiceLogs    PracticeLog[]        @relation("ApprenticeLogs")
  verifiedLogs    PracticeLog[]        @relation("LogVerifier")
  evidence        ApprenticeEvidence[] @relation("ApprenticeEvidence")
  juniorSignoff   JuniorArtistSignoff? @relation("JuniorSignoff")
  juniorSignoffsGiven JuniorArtistSignoff[] @relation("JuniorSignoffBy")
  loyalty         LoyaltyAccount?

  @@schema("public")
}

// Auth.js adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@schema("public")
}

model DeviceLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipHash    String?
  event     String   // signed_in, signed_out, session_revoked
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@schema("public")
}

enum RoleKey {
  OWNER
  STUDIO_MANAGER
  RECEPTION
  RESIDENT_ARTIST
  CHAIR_RENT_ARTIST
  GUEST_ARTIST
  PIERCER
  APPRENTICE
  MENTOR
  CLIENT
  FINANCE_ADVISER
  AI_ASSISTANT

  @@schema("public")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  OFFBOARDED

  @@schema("public")
}

/// A person's relationship with the studio. One user may hold several roles.
model Membership {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studioId        String
  studio          Studio           @relation(fields: [studioId], references: [id])
  roles           RoleKey[]
  customRoleIds   String[]         @default([])
  /// Granular capability overrides, e.g. { "finance.export": true }
  capabilities    Json             @default("{}")
  status          MembershipStatus @default(ACTIVE)
  mfaEnrolled     Boolean          @default(false)
  accessExpiresAt DateTime?        @db.Timestamptz(3)
  lastReviewedAt  DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  compensationModels CompensationModel[]
  contracts          ArtistContractVersion[]

  @@unique([userId, studioId])
  @@schema("public")
}

model CustomRole {
  id           String   @id @default(cuid())
  studioId     String
  studio       Studio   @relation(fields: [studioId], references: [id])
  name         String
  capabilities Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([studioId, name])
  @@schema("public")
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  roles       RoleKey[]
  token       String    @unique
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime  @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@schema("public")
}

// ═══════════════════════════════ Practitioners ══════════════════════════════

enum PractitionerKind {
  TATTOO_ARTIST
  JUNIOR_ARTIST
  PIERCER
  APPRENTICE

  @@schema("public")
}

model ArtistProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug             String           @unique
  displayName      String
  kind             PractitionerKind @default(TATTOO_ARTIST)
  bio              String?
  styles           String[]         @default([])
  instagramHandle  String?
  isPublished      Boolean          @default(false)
  acceptsEnquiries Boolean          @default(true)
  /// For apprentices: the supervising practitioner shown on client-facing reservations.
  supervisorId     String?
  supervisor       ArtistProfile?   @relation("Supervision", fields: [supervisorId], references: [id])
  supervisees      ArtistProfile[]  @relation("Supervision")
  defaultStationId String?
  defaultStation   Station?         @relation(fields: [defaultStationId], references: [id])
  // Rate card and boundaries (editable by the practitioner and the owner; the desk reads them)
  hourlyRateMinPence   Int?
  hourlyRateMaxPence   Int?
  dayRatePence         Int?
  minimumChargePence   Int?
  stylesNotOffered     String[]        @default([])
  wontDo               String?         // free text, public
  placementsDeclined   String[]        @default([])
  /// Piercers: sites offered and declined
  piercingsOffered     String[]        @default([])
  piercingsNotOffered  String[]        @default([])
  receptionNotes       String?         // internal only, never public
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  availabilityRules AvailabilityRule[]
  leave             Leave[]
  bookingRequests   BookingRequest[]
  quotes            Quote[]
  appointments      Appointment[]
  holds             BookingHold[]
  portfolioItems    PortfolioItem[]
  licences          PractitionerLicence[]
  insurance         InsuranceRecord[]
  ledgerEntries     FinancialLedgerEntry[]
  chairRentCharges  ChairRentCharge[]
  commissionEntries CommissionEntry[]
  payouts           Payout[]
  flashSheets       FlashSheet[]
  designs           Design[]
  applications      ArtistApplication[]
  stockMovements    StockMovement[]
  supervisedLogs    PracticeLog[]       @relation("LogSupervisor")
  priceList         PriceListItem[]
  retailSales       RetailSale[]
  promotions        Promotion[]

  @@schema("public")
}

/// A practitioner's own price list (piercing menu, flash prices, set pieces).
model PriceListItem {
  id              String        @id @default(cuid())
  artistId        String
  artist          ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  name            String
  category        String        // piercing | tattoo | consultation | other
  pricePence      Int
  priceToPence    Int?          // optional range upper bound
  durationMinutes Int?
  includesJewellery Boolean     @default(false)
  notes           String?
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)

  @@index([artistId, category])
  @@schema("public")
}

/// Jewellery and aftercare retail sold to a client from studio stock.
model RetailSale {
  id             String         @id @default(cuid())
  practitionerId String
  practitioner   ArtistProfile  @relation(fields: [practitionerId], references: [id])
  clientUserId   String?
  clientName     String?
  appointmentId  String?
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  quantity       Int
  unitPricePence Int
  totalPence     Int
  method         PaymentMethod
  note           String?
  ledgerGroupId  String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  @@index([practitionerId, createdAt])
  @@schema("public")
}

model PractitionerLicence {
  id          String        @id @default(cuid())
  artistId    String
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  authority   String        // e.g. local authority registration
  reference   String?
  issuedAt    DateTime?     @db.Timestamptz(3)
  expiresAt   DateTime?     @db.Timestamptz(3)
  evidenceKey String?       // storage key, restricted
  verifiedAt  DateTime?     @db.Timestamptz(3)

  @@schema("public")
}

model InsuranceRecord {
  id          String        @id @default(cuid())
  artistId    String
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  insurer     String
  policyRef   String?
  expiresAt   DateTime      @db.Timestamptz(3)
  evidenceKey String?
  verifiedAt  DateTime?     @db.Timestamptz(3)

  @@schema("public")
}

model Station {
  id           String   @id @default(cuid())
  studioId     String
  studio       Studio   @relation(fields: [studioId], references: [id])
  name         String
  kind         String   @default("TATTOO") // TATTOO | PIERCING | CONSULT
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  artists      ArtistProfile[]
  appointments Appointment[]
  holds        BookingHold[]

  @@unique([studioId, name])
  @@schema("public")
}

/// Recurring weekly working window, Europe/London local minutes-from-midnight.
/// A one-off day is a rule whose validFrom and validTo are the same date.
model AvailabilityRule {
  id              String        @id @default(cuid())
  artistId        String
  artist          ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  weekday         Int           // 1 = Monday … 7 = Sunday (ISO)
  startMinute     Int
  endMinute       Int
  validFrom       DateTime?     @db.Date
  validTo         DateTime?     @db.Date
  /// Offered as online booking slots.
  acceptsBookings Boolean       @default(true)
  /// Shown publicly as walk-in hours; never offered as online slots unless acceptsBookings is also true.
  acceptsWalkIns  Boolean       @default(false)
  label           String?       // e.g. "Flash day", "Guest spot"

  @@index([artistId, weekday])
  @@schema("public")
}

model Leave {
  id        String        @id @default(cuid())
  artistId  String
  artist    ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  startsAt  DateTime      @db.Timestamptz(3)
  endsAt    DateTime      @db.Timestamptz(3)
  reason    String?

  @@index([artistId, startsAt, endsAt])
  @@schema("public")
}

// ═══════════════════════════════ Clients ════════════════════════════════════

model ClientProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredName      String?
  dateOfBirth        DateTime? @db.Date
  phone              String?
  accessNeeds        String?   // reasonable adjustments, voluntarily disclosed
  emergencyContact   String?
  howFound           String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  ageVerifications   AgeVerification[]

  @@schema("public")
}

/// In-person photographic ID check outcome recorded by staff. No ID copies stored.
model AgeVerification {
  id             String        @id @default(cuid())
  clientId       String
  client         ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])
  checkedById    String
  documentType   String        // passport | driving_licence | pass_card | other
  outcome        String        // verified | failed | not_presented
  dateOfBirthSeen DateTime?    @db.Date
  notes          String?
  checkedAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@schema("public")
}

enum PrivacyPurpose {
  TREATMENT_PHOTOGRAPHY
  PORTFOLIO_PUBLICATION
  SOCIAL_MEDIA
  MARKETING_EMAIL
  MARKETING_SMS
  MERCHANDISE_USE
  WHATSAPP_CONTACT

  @@schema("public")
}

/// Separate, un-bundled opt-ins. Never pre-ticked.
model PrivacyPreference {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     PrivacyPurpose
  granted     Boolean
  grantedAt   DateTime?      @db.Timestamptz(3)
  withdrawnAt DateTime?      @db.Timestamptz(3)
  source      String?        // portal | tablet | staff
  version     Int            @default(1)

  @@unique([userId, purpose, version])
  @@schema("public")
}

// ═══════════════════════════════ Enquiry → booking ══════════════════════════

enum ServiceCategory {
  TATTOO
  CONSULTATION
  PIERCING
  FLASH
  MULTI_SESSION_PROJECT

  @@schema("public")
}

model Service {
  id              String          @id @default(cuid())
  studioId        String
  studio          Studio          @relation(fields: [studioId], references: [id])
  name            String
  category        ServiceCategory
  defaultMinutes  Int
  setupMinutes    Int             @default(15)
  cleanMinutes    Int             @default(15)
  priceFromPence  Int?
  depositPence    Int?
  minimumAge      Int             @default(18)
  /// Piercing-specific: permitted site, aftercare category, jurisdiction notes
  piercingSite    String?
  aftercareCategory String?
  requiresPolicyReview Boolean    @default(false)
  isActive        Boolean         @default(true)

  bookingRequests BookingRequest[]
  appointments    Appointment[]

  @@schema("public")
}

enum EnquiryStatus {
  NEW
  NEEDS_INFORMATION
  IN_DISCUSSION
  QUOTED
  AWAITING_ACCEPTANCE
  AWAITING_DEPOSIT
  CONFIRMED
  FORMS_PENDING
  CHECKED_IN
  IN_SESSION
  COMPLETED
  CANCELLED
  EXPIRED
  DECLINED
  NO_SHOW
  RESCHEDULE_REQUESTED
  REFUNDED
  DISPUTED

  @@schema("public")
}

enum EnquirySource {
  WEBSITE
  WALK_IN
  TELEPHONE
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  REFERRAL
  OTHER

  @@schema("public")
}

model BookingRequest {
  id               String          @id @default(cuid())
  reference        String          @unique // ENQ-2026-000123
  studioId         String
  studio           Studio          @relation(fields: [studioId], references: [id])
  clientId         String
  client           User            @relation("ClientRequests", fields: [clientId], references: [id])
  createdById      String?         // staff member who logged a phone/walk-in enquiry
  createdBy        User?           @relation("CreatedByStaff", fields: [createdById], references: [id])
  artistId         String?         // null = "match me with an artist"
  artist           ArtistProfile?  @relation(fields: [artistId], references: [id])
  serviceId        String?
  service          Service?        @relation(fields: [serviceId], references: [id])
  designId         String?         // flash catalogue design this booking is for
  design           Design?         @relation(fields: [designId], references: [id])
  designSize       String?         // small | palm
  designTier       String?         // artist | apprentice
  category         ServiceCategory
  source           EnquirySource   @default(WEBSITE)
  status           EnquiryStatus   @default(NEW)

  // Structured brief
  placement        String?
  bodyMapZone      String?
  sizeCm           Int?
  style            String?
  colour           String?         // colour | black_and_grey | undecided
  isCoverUp        Boolean         @default(false)
  hasScarConcern   Boolean         @default(false)
  description      String
  budgetBand       String?
  preferredDays    String[]        @default([])
  availabilityNote String?
  accessNeeds      String?
  /// Client-declared age confirmation at enquiry time; ID still checked in person.
  declaredOver18   Boolean         @default(false)
  dateOfBirth      DateTime?       @db.Date
  referralCode     String?

  expiresAt        DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  statusEvents     EnquiryStatusEvent[]
  attachments      ImageAsset[]
  conversation     Conversation?
  quotes           Quote[]
  appointments     Appointment[]
  holds            BookingHold[]
  project          Project?

  @@index([artistId, status])
  @@index([clientId])
  @@schema("public")
}

model EnquiryStatusEvent {
  id          String         @id @default(cuid())
  requestId   String
  request     BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus  EnquiryStatus?
  toStatus    EnquiryStatus
  actorId     String?
  actorLabel  String         // "Client", "Artist: Mo", "System: deposit webhook"
  note        String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  @@index([requestId, createdAt])
  @@schema("public")
}

model Conversation {
  id         String         @id @default(cuid())
  requestId  String         @unique
  request    BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  messages   Message[]

  @@schema("public")
}

enum MessageVisibility {
  CLIENT_VISIBLE
  INTERNAL_ONLY

  @@schema("public")
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation(fields: [senderId], references: [id])
  body           String
  visibility     MessageVisibility @default(CLIENT_VISIBLE)
  readAt         DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  attachments    ImageAsset[]

  @@index([conversationId, createdAt])
  @@schema("public")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  SUPERSEDED
  EXPIRED

  @@schema("public")
}

model Quote {
  id               String         @id @default(cuid())
  requestId        String
  request          BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  artistId         String
  artist           ArtistProfile  @relation(fields: [artistId], references: [id])
  issuedById       String
  issuedBy         User           @relation("QuoteIssuer", fields: [issuedById], references: [id])
  version          Int            @default(1)
  status           QuoteStatus    @default(DRAFT)
  scope            String
  priceBasis       String         // hourly | fixed | per_session | day_rate
  amountPence      Int
  depositPence     Int
  estimatedMinutes Int
  sessions         Int            @default(1)
  termsVersion     String
  termsText        String
  expiresAt        DateTime?      @db.Timestamptz(3)
  sentAt           DateTime?      @db.Timestamptz(3)
  respondedAt      DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([requestId, version])
  @@schema("public")
}

model Project {
  id         String         @id @default(cuid())
  requestId  String         @unique
  request    BookingRequest @relation(fields: [requestId], references: [id])
  title      String
  plannedSessions Int       @default(1)
  notes      String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@schema("public")
}

model BookingReferenceCounter {
  prefix String
  year   Int
  next   Int    @default(1)

  @@id([prefix, year])
  @@schema("public")
}

/// Short-lived reservation of a slot while the client pays the deposit.
model BookingHold {
  id          String         @id @default(cuid())
  requestId   String
  request     BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  clientId    String
  client      User           @relation(fields: [clientId], references: [id])
  artistId    String
  artist      ArtistProfile  @relation(fields: [artistId], references: [id])
  stationId   String?
  station     Station?       @relation(fields: [stationId], references: [id])
  startsAt    DateTime       @db.Timestamptz(3)
  endsAt      DateTime       @db.Timestamptz(3)
  expiresAt   DateTime       @db.Timestamptz(3)
  consumedAt  DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  @@index([artistId, startsAt, endsAt])
  @@schema("public")
}

enum AppointmentStatus {
  PENDING_DEPOSIT
  CONFIRMED
  CHECKED_IN
  IN_SESSION
  COMPLETED
  CANCELLED
  NO_SHOW

  @@schema("public")
}

model Appointment {
  id            String            @id @default(cuid())
  reference     String            @unique // RI-2026-001234
  studioId      String
  studio        Studio            @relation(fields: [studioId], references: [id])
  requestId     String?
  request       BookingRequest?   @relation(fields: [requestId], references: [id])
  clientId      String
  client        User              @relation("ClientAppointments", fields: [clientId], references: [id])
  artistId      String
  artist        ArtistProfile     @relation(fields: [artistId], references: [id])
  stationId     String?
  station       Station?          @relation(fields: [stationId], references: [id])
  serviceId     String?
  service       Service?          @relation(fields: [serviceId], references: [id])
  category      ServiceCategory
  status        AppointmentStatus @default(PENDING_DEPOSIT)
  /// Blocked window including setup and clean-down buffers.
  startsAt      DateTime          @db.Timestamptz(3)
  endsAt        DateTime          @db.Timestamptz(3)
  setupMinutes  Int               @default(0)
  cleanMinutes  Int               @default(0)
  quotedPence   Int?
  depositPence  Int               @default(0)
  depositPaidAt DateTime?         @db.Timestamptz(3)
  creditAppliedPence Int          @default(0)
  completedAt   DateTime?         @db.Timestamptz(3)
  finalPricePence Int?
  holdExpiresAt DateTime?         @db.Timestamptz(3)
  noShowFlag    Boolean           @default(false)
  noShowReviewNote String?
  cancelledAt   DateTime?         @db.Timestamptz(3)
  cancelReason  String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  payments         Payment[]
  ageVerifications AgeVerification[]
  consentResponses ConsentResponse[]
  sessionLogs      SessionLog[]
  generatedPdfs    GeneratedPDF[]
  cancellation     Cancellation?
  ledgerEntries    FinancialLedgerEntry[]

  @@index([artistId, startsAt])
  @@index([clientId])
  @@index([stationId, startsAt])
  @@schema("public")
}

model Cancellation {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  initiatedBy   String      // client | artist | owner | system
  reason        String
  depositOutcome String     // retained | refunded | credited | pending_review
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@schema("public")
}

model Waitlist {
  id          String   @id @default(cuid())
  clientEmail String
  artistId    String?
  category    ServiceCategory
  note        String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@schema("public")
}

// ═══════════════════════════════ Media ══════════════════════════════════════

enum MediaVisibility {
  PRIVATE_REFERENCE   // client uploads, design drafts — never publishable
  PRIVATE_TREATMENT   // photos taken in session — publication needs permission
  PORTFOLIO_PENDING   // approved for internal review
  PORTFOLIO_PUBLIC

  @@schema("public")
}

enum ScanStatus {
  PENDING
  CLEAN
  FLAGGED
  SKIPPED

  @@schema("public")
}

model ImageAsset {
  id              String          @id @default(cuid())
  uploadedById    String?
  uploadedBy      User?           @relation(fields: [uploadedById], references: [id])
  requestId       String?
  request         BookingRequest? @relation(fields: [requestId], references: [id])
  messageId       String?
  message         Message?        @relation(fields: [messageId], references: [id])
  storageKey      String          @unique
  originalName    String
  mimeType        String
