// Rebellious Hustler store: Prisma schema.
//
// Conventions
//  - Every model and enum lives in the Postgres schema "shop" so the store can share a
//    database server with another application without clashing tables.
//  - Money is integer pence (GBP). Never floats.
//  - Timestamps are timestamptz.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["shop"]
}

// ───────────────────────────── Admin ─────────────────────────────

model AdminUser {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  /// Bumped on password change so older session cookies stop working.
  sessionVersion     Int       @default(1)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  @@schema("shop")
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@schema("shop")
}

// ───────────────────────────── Settings ─────────────────────────────

model StoreSettings {
  id                         String   @id @default("default")
  shippingStandardPence      Int      @default(395)
  shippingExpressPence       Int      @default(695)
  freeShippingThresholdPence Int      @default(6000)
  announcement               String   @default("")
  contactEmail               String   @default("")
  instagramHandle            String   @default("")
  storeAddress               String   @default("")
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)

  @@schema("shop")
}

// ───────────────────────────── Catalogue ─────────────────────────────

enum Audience {
  MENS
  WOMENS
  BOYS
  GIRLS
  UNISEX

  @@schema("shop")
}

enum Category {
  TRACKSUITS
  T_SHIRTS
  HOODIES
  SPORTSWEAR
  ACCESSORIES

  @@schema("shop")
}

enum ProductStatus {
  DRAFT
  LIVE
  ARCHIVED

  @@schema("shop")
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String        @default("")
  audience       Audience
  category       Category
  pricePence     Int
  compareAtPence Int?
  status         ProductStatus @default(DRAFT)
  featured       Boolean       @default(false)
  /// Seeded sample product shown with a notice in the admin.
  isSample       Boolean       @default(false)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  images   ProductImage[]
  variants ProductVariant[]

  @@index([status, audience, category])
  @@schema("shop")
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  thumbUrl   String
  storageKey String
  thumbKey   String
  alt        String   @default("")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([productId, position])
  @@schema("shop")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  colour    String
  sku       String   @unique
  stockQty  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, colour])
  @@schema("shop")
}

// ───────────────────────────── Cart ─────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  items     CartItem[]

  @@schema("shop")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([cartId, variantId])
  @@schema("shop")
}

// ───────────────────────────── Orders ─────────────────────────────

enum OrderStatus {
  PAID
  FULFILLED
  CANCELLED
  REFUNDED

  @@schema("shop")
}

/// One row per year; sequence feeds order numbers RH-YYYY-000001.
model OrderCounter {
  year         Int @id
  lastSequence Int @default(0)

  @@schema("shop")
}

model Order {
  id                    String      @id @default(cuid())
  number                String      @unique
  status                OrderStatus @default(PAID)
  email                 String
  customerName          String      @default("")
  shippingAddress       Json
  shippingMethod        String
  subtotalPence         Int
  shippingPence         Int
  totalPence            Int
  stripeSessionId       String      @unique
  stripePaymentIntentId String?
  trackingRef           String?
  fulfilledAt           DateTime?   @db.Timestamptz(3)
  /// Free text for cancellations and refunds (refunds are issued in the Stripe dashboard).
  adminNote             String      @default("")
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @db.Timestamptz(3)

  items OrderItem[]

  @@index([email])
  @@index([createdAt])
  @@schema("shop")
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  size        String
  colour      String
  sku         String
  unitPence   Int
  quantity    Int

  @@schema("shop")
}

/// Every Stripe event id seen, so a redelivered webhook is ignored.
model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@schema("shop")
}
