# Rebellious Hustler store: environment variable template.
# Copy to .env for local work or set these in your hosting provider. Never commit real values.

# PostgreSQL connection. The store keeps every table in the "shop" schema so it can share a server with another app.
DATABASE_URL="postgresql://postgres@localhost:5433/rebellious_hustler?schema=shop"

# Public origin of the site, used for Stripe return URLs, emails, the sitemap and Open Graph tags.
APP_BASE_URL="http://localhost:3000"

# Secret used to sign the cart cookie and the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Stripe. Use test keys until the shop is ready to take real money.
STRIPE_SECRET_KEY=""
# Signing secret for the webhook endpoint /api/stripe/webhook (from the Stripe dashboard or the Stripe CLI).
STRIPE_WEBHOOK_SECRET=""

# Vercel Blob (public store) for product photos. On Vercel the store is connected to the project and
# BLOB_STORE_ID is set automatically; the SDK then fetches its own short-lived token. Set
# BLOB_READ_WRITE_TOKEN only when running outside Vercel. With neither set, uploads go to ./storage on disk.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# Resend for order confirmation and dispatch emails. When unset, emails are logged to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="Rebellious Hustler <orders@rebellioushustler.com>"

# Password for the first admin user ("hustler"), read by the seed script only. The admin is asked to change it on first login.
ADMIN_INITIAL_PASSWORD=""
