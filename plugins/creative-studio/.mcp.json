{
  "image-studio": {
    "command": "node",
    "args": ["${CLAUDE_PLUGIN_ROOT}/server/image-studio.mjs"],
    "env": {
      "OPENAI_API_KEY": "${OPENAI_API_KEY:-}",
      "GEMINI_API_KEY": "${GEMINI_API_KEY:-}",
      "IMAGE_DEFAULT_PROVIDER": "${IMAGE_DEFAULT_PROVIDER:-}",
      "OPENAI_IMAGE_MODEL": "${OPENAI_IMAGE_MODEL:-gpt-image-2.5-sunburst}",
      "GEMINI_IMAGE_MODEL": "${GEMINI_IMAGE_MODEL:-gemini-3-pro-image}",
      "IMAGE_OUTPUT_DIR": "${IMAGE_OUTPUT_DIR:-generated-images}"
    }
  }
}
